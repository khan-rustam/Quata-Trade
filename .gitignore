# dependencies
node_modules/
.pnpm-store/

# pnpm is the only package manager (Documents/02 §Runtime). A stray npm/yarn
# lockfile bypasses the pnpm-workspace.yaml `allowBuilds` postinstall allowlist,
# which is a Documents/08 §H supply-chain control — keep them out of the repo.
package-lock.json
yarn.lock

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# env & secrets — NEVER commit real env files
.env
.env.*
!.env.example

# test & coverage
coverage/
.nyc_output/
playwright-report/
test-results/
.playwright-mcp/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# docker volumes (local dev data)
.volumes/
